ARG NGINX_IMAGE=nginx:1.27-alpine

FROM node:22-bookworm-slim AS assets

WORKDIR /app

RUN npm config set registry https://registry.npmmirror.com/

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY resources ./resources
COPY public ./public
COPY vite.config.js ./

RUN npm run build

FROM ${NGINX_IMAGE}

WORKDIR /var/www/html

COPY public /var/www/html/public
COPY --from=assets /app/public/build /var/www/html/public/build
COPY docker/nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY docker/nginx/geoflow-app.conf /etc/nginx/snippets/geoflow-app.conf

# Normalize static file permissions for the nginx worker.
RUN find /var/www/html/public -type d -exec chmod 755 {} + \
 && find /var/www/html/public -type f -exec chmod 644 {} +

RUN rm -f /var/www/html/public/storage \
    && ln -s ../storage/app/public /var/www/html/public/storage
